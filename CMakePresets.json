{
    "version": 8,
    "configurePresets": [
        {
            "name": "gcc-arm-base",
            "hidden": true,
            "displayName": "GCC 15.2 arm-none-eabi (base)",
            "description": "Common toolchain settings shared by all gcc-arm presets",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/${presetName}",
                "ARM_TOOLCHAIN_DIR": "/opt/arm/arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi/"
            }
        },
        {
            "name": "gcc-arm-release",
            "displayName": "GCC 15.2 arm-none-eabi (Release, -Os)",
            "description": "Size-optimized release build for production firmware",
            "inherits": [ "gcc-arm-base" ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "gcc-arm-debug",
            "displayName": "GCC 15.2 arm-none-eabi (Debug, -Og)",
            "description": "Debug build with -Og, full debug info and _MAIN_DEBUG_ enabled",
            "inherits": [ "gcc-arm-base" ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "debug": {
                "output": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc-arm-release",
            "configurePreset": "gcc-arm-release"
        },
        {
            "name": "gcc-arm-debug",
            "configurePreset": "gcc-arm-debug"
        }
    ],
    "packagePresets": [
        {
            "name": "package-preset",
            "configurePreset": "gcc-arm-release"
        }
    ]
}
